app-id: dev.invrs.oxide
runtime: org.freedesktop.Platform
runtime-version: '23.08'
sdk: org.freedesktop.Sdk
sdk-extensions:
  - org.freedesktop.Sdk.Extension.rust-stable

command: oxidemanager

finish-args:
  - --share=ipc
  - --socket=x11
  - --socket=wayland
  - --device=dri
  - --filesystem=home

build-options:
  append-path: /usr/lib/sdk/rust-stable/bin
  env:
    CARGO_HOME: /run/build/OxideManager/cargo

modules:
  - name: Oxide
    buildsystem: simple
    build-commands:
      - cargo --offline fetch --manifest-path Cargo.toml --verbose
      - cargo --offline build --release --verbose
      - install -Dm755 ./target/release/oxidemanager -t /app/bin/
      - install -Dm644 data/oxidemanager.desktop /app/share/applications/dev.invrs.oxide.desktop
      - install -Dm644 data/dev.invrs.oxide.metainfo.xml /app/share/metainfo/dev.invrs.oxide.metainfo.xml
#      - install -Dm644 data/icon.png /app/share/icons/hicolor/256x256/apps/dev.invrs.oxide.png
    
    sources:
      - type: git
        url: https://github.com/pezfisk/OxideManager.git
        tag: v0.5.0
      - generated-sources.json

